{
  "name": "google-messages-for-desktop",
  "version": "1.10.1",
  "description": "Google Messages desktop app (Electron). sms/tel/smsto/callto/im protocol compose on Windows, macOS, and Linux.",
  "main": "index.js",
  "scripts": {
    "mac": "npm --prefix electron run build && npm --prefix electron run package:mac",
    "linux": "npm --prefix electron run build && npm --prefix electron run package:linux",
    "windows": "npm run electron:build && npm run electron:package:win",
    "windows:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-host.ps1",
    "windows:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-host.ps1",
    "mac:nativefier-legacy": "npx --yes nativefier@49.0.1 --conceal --platform \"mac\" --icon google-messages-logo.png --name \"Google Messages\" \"https://messages.google.com/web\" --honest --disable-dev-tools --single-instance dist/Mac",
    "linux:nativefier-legacy": "npx --yes nativefier@49.0.1 --platform \"linux\" --icon google-messages-logo.png --name \"Google Messages\" \"https://messages.google.com/web\" --honest --disable-dev-tools --single-instance dist/Linux",
    "electron:dev": "npm --prefix electron run dev",
    "electron:build": "npm --prefix electron run build",
    "electron:package:win": "npm --prefix electron run package:win",
    "electron:package:mac": "npm --prefix electron run package:mac",
    "electron:package:linux": "npm --prefix electron run package:linux",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/release-electron.ps1 -SkipInstall",
    "package:mac": "bash scripts/desktop/release-electron.sh --skip-install",
    "package:linux": "bash scripts/desktop/release-electron.sh --skip-install",
    "clean:dist": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){};try{require('fs').rmSync('electron/dist',{recursive:true,force:true})}catch(e){}\"",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/release-electron.ps1",
    "release:mac": "bash scripts/desktop/release-electron.sh",
    "release:linux": "bash scripts/desktop/release-electron.sh",
    "release:windows:host-legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/release-windows.ps1",
    "build:all": "npm run clean:dist && npm run windows",
    "release": "npm run release:windows",
    "host:dev": "node host/windows/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardlthompson/Google-Messages-For-Desktop.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Kelvin Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edwardlthompson/Google-Messages-For-Desktop/issues"
  },
  "homepage": "https://github.com/edwardlthompson/Google-Messages-For-Desktop#readme",
  "dependencies": {}
}
